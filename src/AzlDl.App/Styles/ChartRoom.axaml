<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:data="using:AzlDl.Core.Data">
  <!-- Chart room: cool chart paper, navy ink, chart magenta (the color nautical charts use for lights and hazards). -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgBrush" Color="#EEF2F4" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F9FBFC" />
      <SolidColorBrush x:Key="InkBrush" Color="#14263A" />
      <SolidColorBrush x:Key="MutedBrush" Color="#475A6C" />
      <SolidColorBrush x:Key="LineBrush" Color="#C6D1DA" />
      <SolidColorBrush x:Key="AccentBrush" Color="#9E2266" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="StageBrush" Color="#E2E9EE" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgBrush" Color="#0D1721" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#14212D" />
      <SolidColorBrush x:Key="InkBrush" Color="#DCE6EE" />
      <SolidColorBrush x:Key="MutedBrush" Color="#93A6B7" />
      <SolidColorBrush x:Key="LineBrush" Color="#2A3B4B" />
      <SolidColorBrush x:Key="AccentBrush" Color="#E57CB6" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="#1A0A12" />
      <SolidColorBrush x:Key="StageBrush" Color="#0A121A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="DisplayFont">avares://azl-dl-app/Assets/Fonts#Big Shoulders Display</FontFamily>
  <FontFamily x:Key="BodyFont">avares://azl-dl-app/Assets/Fonts#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="DataFont">avares://azl-dl-app/Assets/Fonts#IBM Plex Mono</FontFamily>

  <x:Double x:Key="PanelChamfer">0</x:Double>
  <x:Double x:Key="ShipNameSize">76</x:Double>
  <FontWeight x:Key="ShipNameWeight">Bold</FontWeight>
  <FontStyle x:Key="ShipNameStyle">Normal</FontStyle>
  <x:Double x:Key="NameBandHeight">0</x:Double>
  <x:Boolean x:Key="SkinPlateNumbers">False</x:Boolean>
  <x:Boolean x:Key="ShipNameUppercase">True</x:Boolean>

  <!-- Ruled rows with dashed dividers, two columns. -->
  <DataTemplate x:Key="StatsTemplate" x:DataType="data:ShipInfo">
    <ItemsControl ItemsSource="{Binding Stats}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="data:StatValue">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,0,28,0">
            <TextBlock Classes="muted" Text="{Binding Label}" Margin="0,8" />
            <TextBlock Grid.Column="1" Classes="data value" Text="{Binding Value}" Margin="0,8" />
            <Line Grid.Row="1" Grid.ColumnSpan="2" StartPoint="0,0.5" EndPoint="2000,0.5" Height="1"
                  Stroke="{DynamicResource LineBrush}" StrokeThickness="1" StrokeDashArray="4,3" ClipToBounds="True" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>
</ResourceDictionary>
