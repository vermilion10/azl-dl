<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AzlDl.App.Controls">
  <!-- Shared styles. They read only style tokens, so all three styles reuse them unchanged. -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.data">
    <Setter Property="FontFamily" Value="{DynamicResource DataFont}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="controls|ShipNameText">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="{DynamicResource ShipNameSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource ShipNameWeight}" />
    <Setter Property="FontStyle" Value="{DynamicResource ShipNameStyle}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{DynamicResource ShipNameSize}" />
  </Style>

  <Style Selector="controls|ChamferBorder.panel">
    <Setter Property="Chamfer" Value="{DynamicResource PanelChamfer}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- Navigation: the current section is underlined in the accent. -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StageBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- Lists of ships and skins: the selection fills with the accent. -->
  <Style Selector="ListBox.picker">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.picker ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="ListBox.picker ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StageBrush}" />
  </Style>
  <Style Selector="ListBox.picker ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.picker ListBoxItem:selected TextBlock, ListBox.picker ListBoxItem:selected TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- An avatar's initial keeps its own colour on a selected row, where it sits on the avatar, not on the accent. -->
  <Style Selector="ListBox.picker ListBoxItem:selected Border.avatar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>

  <!-- Style cards in Settings: the chosen one gets an accent outline instead of a filled background. -->
  <Style Selector="ListBox.styles ListBoxItem">
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="0,0,16,16" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.styles ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.styles ListBoxItem:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="ListBox.styles ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.styles ListBoxItem:selected /template/ ContentPresenter, ListBox.styles ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The page's main action fills with the accent; everything else stays outlined. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- Square play buttons next to voice lines: outlined, filled with the accent on hover. -->
  <Style Selector="Button.play">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- Filter chips: outlined; a pressed chip fills with the accent. -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StageBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- Ship cards: the card is its own frame, so the button draws nothing around it; hovering lifts it slightly. -->
  <Style Selector="Button.card">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="RenderTransform" Value="translateY(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-3px)" />
  </Style>
  <Style Selector="Border.cardTag">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="#C7101318" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.cardTag TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFamily" Value="{DynamicResource DataFont}" />
  </Style>

  <!-- Equipment rarity stars sit on the card's coloured background, so they carry a shadow to stay legible on gold. -->
  <Style Selector="TextBlock.stars">
    <Setter Property="Foreground" Value="#FFD54A" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Effect" Value="drop-shadow(0 1 2 #E6000000)" />
  </Style>

  <!-- The ring around the equipment card shown in the detail pane. -->
  <Style Selector="Border.selectRing">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.selectRing.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Replies the Commander can pick in Juustagram and Fleet Chat: outlined in the accent, since they are the next step. -->
  <Style Selector="Button.reply">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.reply TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.reply:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- Chat bubbles: the ships' on the surface colour, the Commander's in the accent, as messaging apps tell sides apart. -->
  <Style Selector="Border.bubble">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="4,14,14,14" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MaxWidth" Value="560" />
  </Style>
  <Style Selector="Border.bubble.mine">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="14,4,14,14" />
  </Style>
  <Style Selector="Border.bubble.mine TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- A contact's chats, as chips. -->
  <Style Selector="ListBox.topics">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.topics ListBoxItem">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.topics ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="ListBox.topics ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.topics ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.topics ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
  </Style>

  <!-- Back to the gallery: quiet, like the stage tabs next to it. -->
  <Style Selector="Button.back">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Button.back:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <!-- Keyboard focus is always visible, drawn in the accent. -->
  <Style Selector="Control">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Margin="-2" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
</Styles>
