<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:data="using:AzlDl.Core.Data">
  <!-- Registry book: bright paper, black ink, one sea-green accent; serif italic for ship names only. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InkBrush" Color="#161616" />
      <SolidColorBrush x:Key="MutedBrush" Color="#575757" />
      <SolidColorBrush x:Key="LineBrush" Color="#E0E0E0" />
      <SolidColorBrush x:Key="AccentBrush" Color="#1C6656" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="StageBrush" Color="#F4F4F2" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgBrush" Color="#121413" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#181B1A" />
      <SolidColorBrush x:Key="InkBrush" Color="#EDEDEA" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A5AAA7" />
      <SolidColorBrush x:Key="LineBrush" Color="#2E3331" />
      <SolidColorBrush x:Key="AccentBrush" Color="#6CC2AE" />
      <SolidColorBrush x:Key="AccentInkBrush" Color="#0B1F1A" />
      <SolidColorBrush x:Key="StageBrush" Color="#0E100F" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="DisplayFont">avares://azl-dl-app/Assets/Fonts#Newsreader</FontFamily>
  <FontFamily x:Key="BodyFont">avares://azl-dl-app/Assets/Fonts#Public Sans</FontFamily>
  <FontFamily x:Key="DataFont">avares://azl-dl-app/Assets/Fonts#Public Sans</FontFamily>

  <x:Double x:Key="PanelChamfer">0</x:Double>
  <x:Double x:Key="ShipNameSize">68</x:Double>
  <FontWeight x:Key="ShipNameWeight">Normal</FontWeight>
  <FontStyle x:Key="ShipNameStyle">Italic</FontStyle>
  <x:Double x:Key="NameBandHeight">0</x:Double>
  <x:Boolean x:Key="SkinPlateNumbers">True</x:Boolean>
  <x:Boolean x:Key="ShipNameUppercase">False</x:Boolean>

  <!-- Stat name, dotted leader, value: the register's own way of listing figures. -->
  <DataTemplate x:Key="StatsTemplate" x:DataType="data:ShipInfo">
    <ItemsControl ItemsSource="{Binding Stats}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="data:StatValue">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,28,6">
            <TextBlock Classes="muted" Text="{Binding Label}" VerticalAlignment="Bottom" />
            <Line Grid.Column="1" StartPoint="0,0.5" EndPoint="2000,0.5" Height="1" Stroke="{DynamicResource MutedBrush}"
                  StrokeThickness="1" StrokeDashArray="1,3" VerticalAlignment="Bottom" Margin="6,0,6,5" ClipToBounds="True" />
            <TextBlock Grid.Column="2" Classes="data value" Text="{Binding Value}" VerticalAlignment="Bottom" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>
</ResourceDictionary>
