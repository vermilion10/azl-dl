<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AzlDl.App.ViewModels"
        xmlns:views="using:AzlDl.App.Views"
        x:Class="AzlDl.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="azl-dl"
        Width="1360" Height="880" MinWidth="900" MinHeight="600">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ShipsViewModel">
      <views:ShipsView />
    </DataTemplate>
    <DataTemplate DataType="vm:EquipmentViewModel">
      <views:EquipmentView />
    </DataTemplate>
    <DataTemplate DataType="vm:JuustagramViewModel">
      <views:JuustagramView />
    </DataTemplate>
    <DataTemplate DataType="vm:FleetChatViewModel">
      <views:FleetChatView />
    </DataTemplate>
    <DataTemplate DataType="vm:MusicViewModel">
      <views:MusicView />
    </DataTemplate>
    <DataTemplate DataType="vm:AsmrViewModel">
      <views:AsmrView />
    </DataTemplate>
    <DataTemplate DataType="vm:StoryViewModel">
      <views:StoryView />
    </DataTemplate>
    <DataTemplate DataType="vm:AssetsViewModel">
      <views:AssetsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SyncViewModel">
      <views:SyncView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="22,6">
      <DockPanel>
        <TextBlock Text="azl-dl" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="0,0,28,0" />
        <Panel DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Classes="data muted" Text="EN client data" IsVisible="{Binding !IsBusy}" HorizontalAlignment="Right" />
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}" MaxWidth="420">
            <ProgressBar IsIndeterminate="True" Width="56" MinWidth="56" VerticalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="13" Text="{Binding Activity}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" ToolTip.Tip="{Binding Activity}" />
          </StackPanel>
        </Panel>
        <ListBox Classes="nav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                 AutomationProperties.Name="Sections">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:Section">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ContentControl Content="{Binding SelectedSection.Page}" />
  </DockPanel>
</Window>
