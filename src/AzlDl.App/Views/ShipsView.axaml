<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzlDl.App.ViewModels"
             xmlns:data="using:AzlDl.Core.Data"
             xmlns:controls="using:AzlDl.App.Controls"
             xmlns:viewer="using:AzlDl.Core.Viewer"
             x:Class="AzlDl.App.Views.ShipsView"
             x:DataType="vm:ShipsViewModel">
  <Panel>
    <!-- Loading and problem states cover the page until the data is in. -->
    <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="360">
      <ProgressBar IsIndeterminate="True" />
      <TextBlock Classes="muted" Text="{Binding Message}" TextAlignment="Center" />
    </StackPanel>
    <StackPanel IsVisible="{Binding HasProblem}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="560">
      <TextBlock Text="Ship data isn't available" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
      <Button Classes="primary" Content="Go to Sync" Command="{Binding GoToSyncCommand}" Margin="0,8,0,0" />
    </StackPanel>

    <Grid IsVisible="{Binding IsReady}" ColumnDefinitions="280,*,440">
      <!-- Ship list -->
      <DockPanel Background="{DynamicResource SurfaceBrush}">
        <TextBox DockPanel.Dock="Top" Margin="16,16,16,8" PlaceholderText="Search ships" Text="{Binding Filter}"
                 AutomationProperties.Name="Search ships" />
        <TextBlock DockPanel.Dock="Bottom" Classes="muted data" Margin="16,8" FontSize="12"
                   Text="{Binding Ships.Count, StringFormat='{}{0} ships'}" />
        <ListBox Classes="picker" ItemsSource="{Binding Ships}" SelectedItem="{Binding SelectedShip}"
                 AutomationProperties.Name="Ships">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="data:ShipInfo">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding TypeName}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Stage: the painting, or the chibi / Live2D model in the viewer page -->
      <Border Grid.Column="1" Background="{DynamicResource StageBrush}">
        <DockPanel>
          <ListBox DockPanel.Dock="Top" Classes="nav" Margin="16,8,16,0" ItemsSource="{Binding StageOptions}"
                   SelectedItem="{Binding SelectedStage}" AutomationProperties.Name="Stage">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StageOption">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Panel Margin="24">
            <!-- Painting -->
            <Panel IsVisible="{Binding ShowsPainting}">
              <Image Source="{Binding Painting}" IsVisible="{Binding PaintingShown}" Stretch="Uniform" />
              <StackPanel IsVisible="{Binding !PaintingShown}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12" MaxWidth="380">
                <TextBlock Classes="data" Text="{Binding SelectedSkin.Painting}" FontSize="18" FontWeight="Medium"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding PaintingMessage}" TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding PaintingBusy}" />
                <Button Classes="primary" IsVisible="{Binding CanDownloadPainting}" Command="{Binding DownloadPaintingCommand}"
                        HorizontalAlignment="Center" Content="Download painting" />
              </StackPanel>
            </Panel>

            <!-- Chibi and Live2D -->
            <Panel IsVisible="{Binding ShowsViewer}">
              <controls:ViewerHost Source="{Binding ViewerUrl}" IsVisible="{Binding ViewerReady}" />
              <StackPanel IsVisible="{Binding ViewerMessageShown}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12" MaxWidth="420">
                <TextBlock Classes="muted" Text="{Binding ViewerMessage}" TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding ViewerBusy}" />
              </StackPanel>

              <!-- First use: say what will be downloaded and under which terms, then download only on request. -->
              <StackPanel IsVisible="{Binding NeedsRuntimes}" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Spacing="12" MaxWidth="560">
                <TextBlock Text="The viewer needs its runtimes" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="azl-dl doesn't include these. They are downloaded once from their official hosts into your data folder (about 1.3 MB). Two of them are not open source; by downloading you take on their terms." />
                <ItemsControl ItemsSource="{Binding RuntimeFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewer:RuntimeFile">
                      <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Project}" FontWeight="Medium" />
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding License}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="primary" Content="Download runtimes" Command="{Binding InstallRuntimesCommand}" />
              </StackPanel>
            </Panel>
          </Panel>
        </DockPanel>
      </Border>

      <!-- Ship details -->
      <ScrollViewer Grid.Column="2">
        <controls:ChamferBorder Classes="panel" Margin="0" Padding="30,28">
          <StackPanel Spacing="30">
            <StackPanel Spacing="6">
              <Border Height="{DynamicResource NameBandHeight}" Background="{DynamicResource AccentBrush}" Margin="0,0,0,8"
                      HorizontalAlignment="Stretch" />
              <TextBlock Classes="data muted" FontSize="12" Text="{Binding SelectedShip.StatsId, StringFormat='SHIP {0}'}" />
              <controls:ShipNameText NameText="{Binding SelectedShip.Name}" />
              <WrapPanel>
                <TextBlock Classes="muted" Text="{Binding SelectedShip.TypeName}" Margin="0,0,16,0" />
                <TextBlock Classes="muted" Text="{Binding SelectedShip.NationName}" Margin="0,0,16,0" />
                <TextBlock Classes="accent" Text="{Binding SelectedShip.RarityName}" />
              </WrapPanel>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="heading" Text="Stats" />
              <ContentControl Content="{Binding SelectedShip}" ContentTemplate="{DynamicResource StatsTemplate}" />
              <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                         Text="Level 1, fully limit broken, from ship_data_statistics." />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="heading" Text="Skills" />
              <ItemsControl ItemsSource="{Binding SelectedShip.Skills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="data:SkillInfo">
                    <StackPanel Spacing="4" Margin="0,0,0,16">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="22" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding MaxLevel, StringFormat='Values at level 1 → level {0}'}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="heading" Text="Skins" />
              <ListBox Classes="picker" ItemsSource="{Binding SelectedShip.Skins}" SelectedItem="{Binding SelectedSkin}"
                       AutomationProperties.Name="Skins">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="data:SkinInfo">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="data muted" FontSize="12" Text="{Binding Painting}"
                                 VerticalAlignment="Center" />
                      <TextBlock DockPanel.Dock="Left" Classes="data muted" FontSize="12" Width="44" VerticalAlignment="Center"
                                 IsVisible="{DynamicResource SkinPlateNumbers}" Text="{Binding Number, StringFormat='Pl. {0}'}" />
                      <TextBlock Text="{Binding Name}" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="heading" Text="{Binding SelectedSkin.Name, StringFormat='Voice lines: {0}'}" />
              <ItemsControl ItemsSource="{Binding VoiceLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="data:VoiceLine">
                    <StackPanel Spacing="2" Margin="0,0,0,12">
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding Label}" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="22" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </controls:ChamferBorder>
      </ScrollViewer>
    </Grid>
  </Panel>
</UserControl>
