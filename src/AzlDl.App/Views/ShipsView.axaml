<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzlDl.App.ViewModels"
             xmlns:data="using:AzlDl.Core.Data"
             xmlns:controls="using:AzlDl.App.Controls"
             xmlns:viewer="using:AzlDl.Core.Viewer"
             x:Class="AzlDl.App.Views.ShipsView"
             x:Name="Root"
             x:DataType="vm:ShipsViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding BackToGalleryCommand}" />
  </UserControl.KeyBindings>
  <Panel>
    <!-- Loading and problem states cover the page until the data is in. -->
    <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="360">
      <ProgressBar IsIndeterminate="True" />
      <TextBlock Classes="muted" Text="{Binding Message}" TextAlignment="Center" />
    </StackPanel>
    <StackPanel IsVisible="{Binding HasProblem}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="560">
      <TextBlock Text="Ship data isn't available" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
      <Button Classes="primary" Content="Go to Sync" Command="{Binding GoToSyncCommand}" Margin="0,8,0,0" />
    </StackPanel>

    <!-- Gallery: every ship as a card in its rarity's frame, narrowed by the filters on the left. -->
    <Grid IsVisible="{Binding IsReady}">
    <Grid IsVisible="{Binding IsGallery}" ColumnDefinitions="300,*">
      <DockPanel Background="{DynamicResource SurfaceBrush}">
        <TextBox DockPanel.Dock="Top" Margin="16,16,16,4" PlaceholderText="Search ships" Text="{Binding Filter}"
                 AutomationProperties.Name="Search ships" />
        <Button DockPanel.Dock="Bottom" Margin="16,8,16,16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="Clear filters" Command="{Binding ClearFiltersCommand}" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding FilterGroups}" Margin="16,0" />
        </ScrollViewer>
      </DockPanel>

      <DockPanel Grid.Column="1" Background="{DynamicResource StageBrush}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="24,16,24,4">
          <TextBlock Classes="data muted" FontSize="13" VerticalAlignment="Center" Text="{Binding ShownTitle}" />
          <Button Grid.Column="1" Margin="0,0,12,0" Content="{Binding ImageDownloadTitle}" IsVisible="{Binding CanDownloadImages}"
                  Command="{Binding DownloadShipImagesCommand}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="muted" Text="Sort" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="180"
                      AutomationProperties.Name="Sort ships">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SortOption">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Margin="24,4,24,0" Spacing="6"
                    IsVisible="{Binding ImageMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Classes="muted" FontSize="13" Text="{Binding ImageMessage}" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding ImagesBusy}" />
        </StackPanel>

        <Panel>
          <ItemsControl x:Name="CardList" ItemsSource="{Binding CardRows}" Padding="24,12,12,24"
                        XYFocus.NavigationModes="Keyboard" AutomationProperties.Name="Ships">
            <ItemsControl.Template>
              <ControlTemplate>
                <ScrollViewer>
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}" />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShipCardRow">
                <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,12">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShipCard">
                      <Button Classes="card" Command="{Binding #Root.((vm:ShipsViewModel)DataContext).OpenShipCommand}"
                              CommandParameter="{Binding Ship}"
                              AutomationProperties.Name="{Binding Ship.Name}">
                        <ToolTip.Tip>
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Ship.Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Ship.TypeName}" />
                            <TextBlock Text="{Binding Ship.NationName}" />
                          </StackPanel>
                        </ToolTip.Tip>
                        <!-- The game's card: rarity background, the ship, stars and hull badge, and the rarity frame on top.
                             Until the game's art is downloaded the frame is drawn in the rarity's colours, with text tags. -->
                        <Panel Width="{x:Static vm:ShipsViewModel.CardWidth}" Height="{x:Static vm:ShipsViewModel.CardHeight}">
                          <Border CornerRadius="4" BorderThickness="2"
                                  BorderBrush="{Binding Ship.Tier, Converter={x:Static controls:RarityBrushes.Border}}"
                                  Background="{Binding Ship.Tier, Converter={x:Static controls:RarityBrushes.Background}}" />
                          <!-- The frame's bottom bar is thicker than its sides. -->
                          <Panel Margin="5,5,5,8" ClipToBounds="True">
                            <Image Source="{Binding Ship.RarityKey, Converter={x:Static controls:GameArt.Image}, ConverterParameter=card_}"
                                   Stretch="Fill" />
                            <Image Source="{Binding Image}" Stretch="UniformToFill" VerticalAlignment="Top" />
                            <!-- Not downloaded yet: a question mark keeps the card's place and frame. -->
                            <TextBlock Text="?" IsVisible="{Binding !HasImage}" FontSize="56" FontWeight="Bold" Foreground="#B3FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" />
                            <Image Width="36" Height="22" Margin="4,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Source="{Binding Ship.TypeId, Converter={x:Static controls:GameArt.Image}, ConverterParameter=hull_}" />
                            <Border Classes="cardTag" HorizontalAlignment="Left" CornerRadius="0,0,4,0"
                                    IsVisible="{Binding !#Root.((vm:ShipsViewModel)DataContext).HasGameArt}">
                              <TextBlock Text="{Binding Ship.TierCode}" />
                            </Border>
                            <Border Classes="cardTag" HorizontalAlignment="Right" CornerRadius="0,0,0,4"
                                    IsVisible="{Binding !#Root.((vm:ShipsViewModel)DataContext).HasGameArt}">
                              <TextBlock Text="{Binding Ship.HullCode}" />
                            </Border>
                            <StackPanel VerticalAlignment="Bottom">
                              <ItemsControl ItemsSource="{Binding Ship.StarSlots}" HorizontalAlignment="Center" Margin="0,0,0,2"
                                            IsVisible="{Binding #Root.((vm:ShipsViewModel)DataContext).HasGameArt}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Image Width="14" Height="13" Source="{Binding Source={x:Static controls:GameArt.Star}}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Border Background="#D9101318" Padding="6,4">
                                <TextBlock Text="{Binding Ship.Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                              </Border>
                            </StackPanel>
                          </Panel>
                          <Image Stretch="Fill"
                                 Source="{Binding Ship.RarityKey, Converter={x:Static controls:GameArt.Image}, ConverterParameter=frame_}" />
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding NoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Classes="muted" Text="No ship matches these filters." />
            <Button HorizontalAlignment="Center" Content="Clear filters" Command="{Binding ClearFiltersCommand}" />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Grid>

    <Grid IsVisible="{Binding IsDetail}" ColumnDefinitions="*,440">
      <!-- Stage: the painting, or the chibi / Live2D model in the viewer page -->
      <Border Background="{DynamicResource StageBrush}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="16,8,16,0">
            <Button DockPanel.Dock="Left" Classes="back" Command="{Binding BackToGalleryCommand}" Margin="0,0,16,0"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Center" ToolTip.Tip="Back to all ships (Esc)"
                    Content="‹ All ships" />
            <ListBox Classes="nav" ItemsSource="{Binding StageOptions}"
                     SelectedItem="{Binding SelectedStage}" AutomationProperties.Name="Stage">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:StageOption">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Panel Margin="24">
            <!-- Painting -->
            <Panel IsVisible="{Binding ShowsPainting}">
              <DockPanel IsVisible="{Binding PaintingShown}">
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Classes="muted" Text="Expression" VerticalAlignment="Center" Margin="0,0,10,0"
                             IsVisible="{Binding HasFaces}" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Faces}" SelectedItem="{Binding SelectedFace}" MaxWidth="460"
                            HorizontalAlignment="Left" IsVisible="{Binding HasFaces}" Margin="0,0,16,0"
                            AutomationProperties.Name="Expression">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FaceOption">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Column="2" Classes="muted" FontSize="13" VerticalAlignment="Center"
                             Text="Scroll to zoom · drag to move · double-click to reset" />
                </Grid>
                <controls:ZoomPanel ResetOn="{Binding Painting}"
                                    AutomationProperties.Name="Painting. Plus and minus zoom, arrow keys move, 0 resets.">
                  <!-- The face is drawn over the painting in the painting's own pixels, so both scale together. -->
                  <Viewbox Stretch="Uniform">
                    <Canvas Width="{Binding PaintingWidth}" Height="{Binding PaintingHeight}">
                      <Image Source="{Binding Painting}" Width="{Binding PaintingWidth}" Height="{Binding PaintingHeight}" />
                      <Image Source="{Binding Face}" Canvas.Left="{Binding FaceSlot.X}" Canvas.Top="{Binding FaceSlot.Y}"
                             Width="{Binding FaceSlot.Width}" Height="{Binding FaceSlot.Height}" Stretch="Fill" />
                    </Canvas>
                  </Viewbox>
                </controls:ZoomPanel>
              </DockPanel>
              <StackPanel IsVisible="{Binding !PaintingShown}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12" MaxWidth="380">
                <TextBlock Classes="data" Text="{Binding SelectedSkin.Painting}" FontSize="18" FontWeight="Medium"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding PaintingMessage}" TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding PaintingBusy}" />
                <Button Classes="primary" IsVisible="{Binding CanDownloadPainting}" Command="{Binding DownloadPaintingCommand}"
                        HorizontalAlignment="Center" Content="Download painting" />
              </StackPanel>
            </Panel>

            <!-- Chibi and Live2D -->
            <Panel IsVisible="{Binding ShowsViewer}">
              <controls:ViewerHost Source="{Binding ViewerUrl}" IsVisible="{Binding ViewerReady}" />
              <StackPanel IsVisible="{Binding ViewerMessageShown}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12" MaxWidth="420">
                <TextBlock Classes="muted" Text="{Binding ViewerMessage}" TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding ViewerBusy}" />
              </StackPanel>

              <!-- First use: say what will be downloaded and under which terms, then download only on request. -->
              <StackPanel IsVisible="{Binding NeedsRuntimes}" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Spacing="12" MaxWidth="560">
                <TextBlock Text="The viewer needs its runtimes" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="azl-dl doesn't include these. They are downloaded once from their official hosts into your data folder (about 1.3 MB). Two of them are not open source; by downloading you take on their terms." />
                <ItemsControl ItemsSource="{Binding RuntimeFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewer:RuntimeFile">
                      <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Project}" FontWeight="Medium" />
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding License}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="primary" Content="Download runtimes" Command="{Binding InstallRuntimesCommand}" />
              </StackPanel>
            </Panel>
          </Panel>
        </DockPanel>
      </Border>

      <!-- Ship details -->
      <ScrollViewer Grid.Column="1">
        <controls:ChamferBorder Classes="panel" Margin="0" Padding="30,28">
          <StackPanel Spacing="30">
            <StackPanel Spacing="6">
              <Border Height="{DynamicResource NameBandHeight}" Background="{DynamicResource AccentBrush}" Margin="0,0,0,8"
                      HorizontalAlignment="Stretch" />
              <TextBlock Classes="data muted" FontSize="12" Text="{Binding SelectedShip.StatsId, StringFormat='SHIP {0}'}" />
              <controls:ShipNameText NameText="{Binding SelectedShip.Name}" />
              <WrapPanel>
                <TextBlock Classes="muted" Text="{Binding SelectedShip.TypeName}" Margin="0,0,16,0" />
                <TextBlock Classes="muted" Text="{Binding SelectedShip.NationName}" Margin="0,0,16,0" />
                <TextBlock Classes="accent" Text="{Binding SelectedShip.RarityName}" />
              </WrapPanel>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Classes="heading" Text="Stats" />
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Classes="muted" Text="Level" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="1" Maximum="{Binding MaxLevel}" Value="{Binding StatLevel}"
                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                        AutomationProperties.Name="Level" />
                <NumericUpDown Grid.Column="2" Minimum="1" Maximum="{Binding MaxLevel}" Value="{Binding StatLevel}"
                               Increment="1" FormatString="0" Width="120" AutomationProperties.Name="Level" />
              </Grid>
              <WrapPanel ItemSpacing="16" LineSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="muted" Text="Affinity" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding AffinityLevels}" SelectedItem="{Binding StatAffinity}" MinWidth="180"
                            AutomationProperties.Name="Affinity">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="data:AffinityLevel">
                        <TextBlock Text="{Binding Title}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <CheckBox IsChecked="{Binding StatDeveloped}" Content="{Binding DevelopmentTitle}" />
                <CheckBox IsChecked="{Binding StatRetrofit}" Content="Retrofitted" IsVisible="{Binding HasRetrofit}" />
              </WrapPanel>
              <ContentControl Content="{Binding Stats}" ContentTemplate="{DynamicResource StatsTemplate}" />
              <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                         Text="Fully limit broken, without equipment. Worked out the way the game does it." />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="heading" Text="Skills" />
              <ItemsControl ItemsSource="{Binding SelectedShip.Skills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="data:SkillInfo">
                    <StackPanel Spacing="4" Margin="0,0,0,16">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="22" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding MaxLevel, StringFormat='Values at level 1 → level {0}'}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="heading" Text="Skins" />
              <ListBox Classes="picker" ItemsSource="{Binding SelectedShip.Skins}" SelectedItem="{Binding SelectedSkin}"
                       AutomationProperties.Name="Skins">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="data:SkinInfo">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="data muted" FontSize="12" Text="{Binding Painting}"
                                 VerticalAlignment="Center" />
                      <TextBlock DockPanel.Dock="Left" Classes="data muted" FontSize="12" Width="44" VerticalAlignment="Center"
                                 IsVisible="{DynamicResource SkinPlateNumbers}" Text="{Binding Number, StringFormat='Pl. {0}'}" />
                      <TextBlock Text="{Binding Name}" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="heading" Text="{Binding SelectedSkin.Name, StringFormat='Voice lines: {0}'}" />
              <TextBlock Classes="muted" FontSize="13" Text="{Binding VoiceMessage}" TextWrapping="Wrap" Margin="0,0,0,10"
                         IsVisible="{Binding VoiceMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ItemsControl ItemsSource="{Binding VoiceLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="data:VoiceLine">
                    <DockPanel Margin="0,0,0,12">
                      <Button DockPanel.Dock="Left" Classes="play" VerticalAlignment="Top" Margin="0,0,12,0"
                              IsVisible="{Binding #Root.((vm:ShipsViewModel)DataContext).CanPlayVoices}"
                              Command="{Binding #Root.((vm:ShipsViewModel)DataContext).PlayVoiceCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Label, StringFormat='Play {0}'}" ToolTip.Tip="Play">
                        <Path Data="M 0 0 L 10 6 L 0 12 Z" Fill="{Binding $parent[Button].Foreground}" />
                      </Button>
                      <StackPanel Spacing="2">
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Label}" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="22" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </controls:ChamferBorder>
      </ScrollViewer>
    </Grid>
    </Grid>
  </Panel>
</UserControl>
