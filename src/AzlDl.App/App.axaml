<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzlDl.App.ViewModels"
             xmlns:controls="using:AzlDl.App.Controls"
             x:Class="AzlDl.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://azl-dl-app/Styles/Common.axaml" />
  </Application.Styles>
  <!-- Gallery filters look the same on every page: a heading and a wrap of chips. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:FilterGroup">
      <StackPanel Margin="0,16,0,0">
        <TextBlock Classes="heading" Text="{Binding Title}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="6" LineSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChip">
              <ToggleButton Classes="chip" IsChecked="{Binding IsChecked}"
                            AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="10" Height="14" CornerRadius="2" VerticalAlignment="Center" IsVisible="{Binding HasTier}"
                          Background="{Binding Tier, Converter={x:Static controls:RarityBrushes.Background}}" />
                  <TextBlock Classes="data" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                             Text="{Binding Code}" IsVisible="{Binding HasCode}" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
